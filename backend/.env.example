# Salin file ini menjadi ".env" lalu isi sesuai komputer Anda.
# Jangan pernah meng-commit file .env ke GitHub.

# Port server backend
PORT=5000

# Koneksi MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rrd

# Kunci rahasia untuk token login (JWT). Isi dengan teks acak yang panjang, mis. hasil:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_teks_acak_yang_panjang
